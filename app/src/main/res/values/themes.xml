<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AndroidNumericText" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/demo_background</item>
        <item name="android:colorBackground">@color/demo_background</item>
        <item name="android:colorAccent">@color/demo_accent</item>
        <item name="colorAccent">@color/demo_accent</item>
        <item name="android:colorControlHighlight">@color/demo_ripple</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Demo.Title" parent="">
        <item name="android:textColor">@color/demo_text</item>
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Demo.Body" parent="">
        <item name="android:textColor">@color/demo_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Demo.Mode" parent="">
        <item name="android:textColor">@color/demo_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Demo.Button" parent="Widget.AppCompat.Button">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Demo.StepButton" parent="Demo.Button">
        <item name="android:background">@drawable/demo_button_outline</item>
        <item name="android:textColor">@color/demo_button_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Demo.PrimaryButton" parent="Demo.Button">
        <item name="android:background">@drawable/demo_button_primary</item>
        <item name="android:textColor">@color/demo_on_accent</item>
    </style>

    <style name="Demo.TextButton" parent="Demo.Button">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/demo_secondary</item>
    </style>
</resources>
